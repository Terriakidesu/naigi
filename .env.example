NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Use an application-specific database and least-privilege role outside development.
DATABASE_URL=postgres://localhost:5432/priv_chat

# Include credentials or an ACL username when Redis/Valkey authentication is enabled.
REDIS_URL=redis://localhost:6379
ATTACHMENTS_DIR=./data/attachments

SESSION_TTL_SECONDS=2592000
MAX_ENCRYPTED_MESSAGE_BYTES=262144
MAX_PROTOCOL_METADATA_BYTES=32768
MAX_ATTACHMENT_BYTES=26214400
