# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL. Use an application-specific, least-privilege role outside development.
DATABASE_URL=postgres://localhost:5432/priv_chat

# Redis/Valkey. For authentication, use a URL such as
# redis://:password@127.0.0.1:6379 or redis://username:password@127.0.0.1:6379.
REDIS_URL=redis://localhost:6379

# Local encrypted attachment storage. Replace with object storage in production.
ATTACHMENTS_DIR=./data/attachments

# Session lifetime in seconds.
SESSION_TTL_SECONDS=2592000

# Request limits in bytes.
MAX_ENCRYPTED_MESSAGE_BYTES=262144
MAX_PROTOCOL_METADATA_BYTES=32768
MAX_ATTACHMENT_BYTES=26214400
