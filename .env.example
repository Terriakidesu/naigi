# Runtime
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# PostgreSQL. Use an application-specific, least-privilege role outside development.
DATABASE_URL=postgres://localhost:5432/priv_chat

# Separate PostgreSQL database for host-operator identities and sessions.
ADMIN_DATABASE_URL=postgres://localhost:5432/priv_chat_admin

# Redis/Valkey. For authentication, use a URL such as
# redis://:password@127.0.0.1:6379 or redis://username:password@127.0.0.1:6379.
REDIS_URL=redis://localhost:6379

# Optional self-hosted LiveKit service for encrypted direct calls and space voice rooms.
# Configure all three values together. Use a WSS endpoint in production.
# LIVEKIT_URL=wss://voice.example.com
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Persistent local filesystem storage for encrypted chat attachments and profile images.
ATTACHMENTS_DIR=./data/attachments
PROFILE_IMAGES_DIR=./data/profile-images

# Providers used for the authenticated Twitter/X preview exception. The list
# is an explicit allowlist; remove syndication to avoid the public fallback.
TWITTER_PREVIEW_PROVIDERS=fx,syndication
# The fx provider accepts any self-hosted FxTwitter-compatible /2/status endpoint.
TWITTER_PREVIEW_API_URL=https://api.fxtwitter.com/2/status

# Optional GIF picker providers. These are browser API keys: the authenticated
# browser receives them, then searches each provider directly so search terms
# and GIF URLs never pass through Naigi. Restrict keys to your chat origin.
# KLIPY_API_KEY=
# GIPHY_API_KEY=

# Optional web push notifications (Firebase Cloud Messaging). Create a Firebase
# project/web app, enable Cloud Messaging and generate a Web Push certificate.
# Store the service-account JSON securely; do not commit real credentials.
# Keep each JSON value on one line and encode private_key newlines as \n.
# FCM_SERVICE_ACCOUNT_JSON={"project_id":"...","client_email":"...","private_key":"..."}
# FCM_WEB_CONFIG_JSON={"apiKey":"...","appId":"...","messagingSenderId":"...","projectId":"..."}
# FCM_VAPID_KEY=

# Session lifetime in seconds.
SESSION_TTL_SECONDS=2592000

# Request limits in bytes.
MAX_ENCRYPTED_MESSAGE_BYTES=262144
MAX_PROTOCOL_METADATA_BYTES=32768
MAX_ATTACHMENT_BYTES=26214400
