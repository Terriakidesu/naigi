{
  "name": "priv-chat",
  "version": "1.7.0",
  "scripts": {
    "test": "bun test",
    "test:e2ee": "bun run build:client && bun run scripts/test-e2ee.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "build:client": "bun run scripts/build-client.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:migrate": "bun run src/db/migrate.ts",
    "db:purge": "bun run scripts/purge-db.ts"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "elysia": "latest"
  },
  "devDependencies": {
    "bun-types": "latest",
    "playwright": "^1.63.0"
  },
  "module": "src/index.js"
}
