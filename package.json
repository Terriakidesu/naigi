{
  "name": "priv-chat",
  "version": "0.22.0",
  "description": "Self-hosted, privacy-focused end-to-end encrypted chat app.",
  "scripts": {
    "test": "bun test",
    "test:e2ee": "bun run build:client && bun run scripts/test-e2ee.ts",
    "typecheck": "bunx --bun tsc --noEmit",
    "build:client": "bun run scripts/build-client.ts",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:migrate": "bun run src/migrate.ts",
    "admin-users": "bun run scripts/admin-users.ts",
    "db:purge": "bun run scripts/purge-db.ts"
  },
  "dependencies": {
    "@matrix-org/matrix-sdk-crypto-wasm": "^18.9.0",
    "elysia": "latest",
    "firebase": "^12.19.0",
    "gifenc": "^1.0.3",
    "gifuct-js": "^2.1.2",
    "livekit-client": "^2.22.3",
    "livekit-server-sdk": "^2.19.1",
    "lucide": "^1.48.0"
  },
  "devDependencies": {
    "bun-types": "latest",
    "playwright": "^1.63.0"
  },
  "module": "src/index.js"
}
